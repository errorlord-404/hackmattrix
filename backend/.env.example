MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=kisansathi
FARM_STATE_DB_DIR=data/farm_state
FARM_STATE_UPLOAD_DIR=data/farm_uploads
# Enable the local-only Tomato sensor simulator for the hackathon demo.
TOMATO_DEMO_ENABLED=false

# Device gateway credentials stay outside Git. JSON keys are device IDs and
# values scope a bearer token to farmer_id and optional field_ids.
# Example: {"soil-node-a17f":{"token":"replace-me","farmer_id":"demo","field_ids":[]}}
DEVICE_INGESTION_CREDENTIALS_JSON={}

# Optional local crop-health demo. These controlled-image checkpoints are for
# SIH demonstration only, not field deployment. Install requirements-ml.txt.
DIAGNOSIS_PROVIDER=unconfigured
# Optional hosted crop-health screening. Keep the key in an untracked runtime
# environment. Set the base URL/path supplied by the operator's Kindwise plan.
KINDWISE_CROP_HEALTH_API_KEY=
KINDWISE_CROP_HEALTH_BASE_URL=
KINDWISE_CROP_HEALTH_IDENTIFICATION_PATH=/api/v1/identification
KINDWISE_CROP_HEALTH_TIMEOUT_SECONDS=20
KINDWISE_CROP_HEALTH_LANGUAGE=en
CROP_HEALTH_ROUTER_MODEL_PATH=
CROP_HEALTH_SPECIALIST_MODELS_JSON={}
CROP_HEALTH_MIN_DISEASE_SCORE=0.70
CROP_HEALTH_MIN_DISEASE_MARGIN=0.15
# Original Codex desktop prototype registry. Run backend/scripts/install_crop_model_bundle.ps1 first.
# Leave DIAGNOSIS_PROVIDER=unconfigured for a normal lightweight launch.
CROP_HEALTH_MODEL_REGISTRY_PATH=
CROP_HEALTH_MODEL_ROOT=
CROP_HEALTH_MODEL_IDS=
CROP_HEALTH_MODEL_MAX_COUNT=4
CROP_HEALTH_TFLITE_MODEL_PATH=
CROP_HEALTH_TFLITE_LABELS_PATH=
CROP_HEALTH_TFLITE_CROP=tomato
# Leave blank for review-only output. A future manifest must bind these exact
# artifacts to passed field-held-out and unknown/OOD release gates.
CROP_HEALTH_TFLITE_RELEASE_MANIFEST_PATH=
# Optional crop router. It returns a suggestion only; do not bypass farmer confirmation.
CROP_HEALTH_TFLITE_ROUTER_MODEL_PATH=
CROP_HEALTH_TFLITE_ROUTER_LABELS_PATH=
CROP_HEALTH_MIN_CROP_SCORE=0.80
CROP_HEALTH_MIN_CROP_MARGIN=0.15

# Generate both values locally; do not commit real secrets.
SCRAPER_WEBHOOK_TOKEN=replace-with-a-long-random-token
N8N_ENCRYPTION_KEY=replace-with-a-different-long-random-key

# Optional. When blank, ingestion reads the public key rendered on the
# official data.gov.in resource page without storing it.
DATA_GOV_IN_API_KEY=

UNIVERSAL_DATA_HTTP_TIMEOUT_SECONDS=30
UNIVERSAL_DATA_PAGE_SIZE=1000
# 0 means ingest every row reported by the official feed.
UNIVERSAL_DATA_MAX_MARKET_RECORDS=0
# Public APEDA directories are read-only discovery sources. 0 means every
# publisher-advertised page; use a positive cap for a shorter development run.
MARKETPLACE_DIRECTORY_SOURCES_JSON=[{"url":"https://agriexchange.apeda.gov.in/AgriDirectory/Exporter/Exporters","name":"APEDA registered exporters","listing_type":"exporter","adapter":"apeda_exporters"},{"url":"https://farmerconnect.apeda.gov.in/Buyer/BuyerDirectory?BusinessType=Importer&Commodities=All&Country=All&Culture=en","name":"APEDA FarmerConnect importers","listing_type":"buyer","adapter":"apeda_buyers"},{"url":"https://agriexchange.apeda.gov.in/AgriDirectory/SProvider/Index","name":"APEDA recognised packhouses","listing_type":"logistics","adapter":"apeda_packhouses"}]
APEDA_EXPORTER_MAX_PAGES=0
APEDA_BUYER_MAX_PAGES=0
APEDA_PACKHOUSE_MAX_PAGES=0
APEDA_DIRECTORY_PAGE_DELAY_SECONDS=0.12
FARMS_NETWORK_STATUS_ENABLED=true
FARMS_CHC_LOOKBACK_DAYS=365
FARMS_CHC_MAX_RECORDS=5000
MSP_MARKETING_YEAR=2026-27
MSP_KHARIF_URL=https://www.pib.gov.in/PressReleasePage.aspx?PRID=2260618&lang=2&reg=48
MSP_RABI_URL=https://www.pib.gov.in/PressReleasePage.aspx?PRID=2173567&lang=35&reg=38

# n8n calls the host-run FastAPI service through this address.
BACKEND_INTERNAL_URL=http://host.docker.internal:8000

# Sarvam AI voice and language services. Keep the real key outside git.
# Set VOICE_PROVIDER=sarvam to enable the combined voice turn endpoint.
VOICE_PROVIDER=unconfigured
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_SECONDS=30
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE_CODE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SPEECH_SAMPLE_RATE=24000
SARVAM_TTS_CODEC=wav
SARVAM_TRANSLATE_MODEL=mayura:v1
