{
  "name": "@kisansathi/standalone-web",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone KisanSathi web/API deployment wrapper",
  "scripts": {
    "deploy:config": "docker compose --env-file deploy/.env.example -f deploy/compose.yaml config",
    "deploy:up": "docker compose --env-file deploy/.env -f deploy/compose.yaml up --build -d",
    "deploy:down": "docker compose --env-file deploy/.env -f deploy/compose.yaml down",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web run test:ui",
    "web:lint": "npm --prefix apps/web run lint",
    "web:standalone": "npm --prefix apps/web run check:standalone",
    "test:web-boundary": "python -m unittest discover -s tests/web -p test_*.py -v",
    "test:vision-routing": "npm --prefix packages/browser-vision test"
  },
  "engines": {
    "node": ">=22"
  }
}
