{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "backbones"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["template", "candidate"]},
    "backbones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backbone_id", "provider", "framework", "builder", "source", "input", "license", "capabilities", "status"],
        "properties": {
          "backbone_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "provider": {"enum": ["torchvision", "keras_applications", "tensorflow_hub", "import_onnx", "import_tflite"]},
          "framework": {"enum": ["torchvision", "keras", "tensorflow_hub", "onnx", "tflite"]},
          "builder": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "required": ["immutable_id", "locator", "revision"],
            "properties": {
              "immutable_id": {"type": "string", "minLength": 8},
              "locator": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "input": {
            "type": "object",
            "required": ["height", "width", "channels"],
            "properties": {
              "height": {"type": "integer", "minimum": 32},
              "width": {"type": "integer", "minimum": 32},
              "channels": {"const": 3}
            },
            "additionalProperties": false
          },
          "license": {
            "type": "object",
            "required": ["name", "identifier", "url", "applies_to", "redistribution_review", "notes"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "identifier": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "applies_to": {"enum": ["implementation", "weights", "imported_artifact"]},
              "redistribution_review": {"const": "required"},
              "notes": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "capabilities": {
            "type": "object",
            "required": ["train", "fine_tune", "export_onnx", "export_tflite"],
            "properties": {
              "train": {"type": "boolean"},
              "fine_tune": {"type": "boolean"},
              "export_onnx": {"type": "boolean"},
              "export_tflite": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "status": {"const": "template"}
        }
      }
    }
  }
}
