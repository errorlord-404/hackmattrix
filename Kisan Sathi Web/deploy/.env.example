# Copy to deploy/.env or inject an equivalent file at runtime.
# Never pass provider credentials as VITE_* variables or Docker build args.

# Public browser configuration: this is the only value compiled into the web image.
VITE_API_BASE_URL=/api

# Optional local operator bindings.
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_PORT=8000

# Standalone API auth. Keep dev mode enabled only for local development; set
# KISANSATHI_ENV=production and provide a secret/gateway bearer in production.
KISANSATHI_ENV=development
KISANSATHI_DEV_MODE=true
KISANSATHI_WEB_BEARER_TOKEN=
KISANSATHI_MAX_INPUT_BYTES=200000
KISANSATHI_MAX_TOOLS=78

# Provider-neutral server-side LLM configuration. Never expose these as VITE_*
# variables, browser storage, or web build arguments.
KISANSATHI_LLM_BASE_URL=
KISANSATHI_LLM_API_KEY=
KISANSATHI_LLM_MODEL=

# Server-only settings. These are read by the api container, never by web.
MONGODB_URL=mongodb://mongo:27017
DATABASE_NAME=kisansathi
SARVAM_API_KEY=
DATA_GOV_IN_API_KEY=
SCRAPER_WEBHOOK_TOKEN=
DEVICE_INGESTION_CREDENTIALS_JSON={}
ADVISOR_PROVIDER=unconfigured
VOICE_PROVIDER=unconfigured
DIAGNOSIS_PROVIDER=unconfigured
# Development/prototype only. Keep false in production; production inference
# requires a separately approved release artifact.
CROP_DISEASE_RESEARCH_MODE=false

# Optional approved model release paths inside the model_releases volume.
# Keep empty until a separately approved release is injected.
CROP_HEALTH_TFLITE_MODEL_PATH=
CROP_HEALTH_TFLITE_LABELS_PATH=
CROP_HEALTH_TFLITE_RELEASE_MANIFEST_PATH=

# Hybrid browser/server CV release descriptor. Leave empty until a real,
# separately approved release manifest and signing secret are provisioned.
CV_RELEASE_MANIFEST_PATH=models/manifests/approved-release.yaml
CV_APPROVAL_RECORD_PATH=docs/APPROVED_RELEASES.json
CV_DESCRIPTOR_SIGNING_SECRET=
