# syntax=docker/dockerfile:1

# The web build is deliberately isolated from server credentials.  Only the
# public same-origin API prefix is compiled into the browser bundle.
FROM node:22-alpine AS build

WORKDIR /workspace
COPY apps/web/package*.json ./
RUN npm ci

COPY apps/web/ ./
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_FARM_STATE_API_URL=${VITE_API_BASE_URL}
ENV VITE_REFERENCE_API_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /workspace/dist/ /usr/share/nginx/html/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1
