# syntax=docker/dockerfile:1

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY services/api/requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
  && python -m pip install -r /tmp/requirements.txt \
  && groupadd --system --gid 10001 kisansathi \
  && useradd --system --uid 10001 --gid kisansathi --home-dir /app --shell /usr/sbin/nologin kisansathi

COPY services/api/ ./
COPY services/harness/ /app/harness/
COPY packages/auth/ /app/packages/auth/
COPY packages/tool-registry/ /app/packages/tool-registry/
COPY models/ /app/models/

# These directories are mount points, not model distribution locations. Model
# releases are injected into the named volume only after separate approval.
RUN mkdir -p /app/data/farm_state /app/data/farm_uploads /app/models/releases /app/models/crop_disease/downloaded \
  && chown -R kisansathi:kisansathi /app

USER kisansathi
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
