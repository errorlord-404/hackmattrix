{
  "name": "kisan-sathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"cross-env VITE_FARM_STATE_API_URL=http://127.0.0.1:8001 VITE_REFERENCE_API_URL=http://127.0.0.1:8001 npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env KISANSATHI_BACKEND_URL=http://127.0.0.1:8001 ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "demo:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "demo:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/demo-check.ps1",
    "demo:contracts": "set PYTHONPATH=backend&& python scripts/check_api_contracts.py",
    "desktop:build": "npm run build && electron .",
    "demo:tflite:check": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run_local_tflite_demo.ps1 -CheckOnly",
    "demo:tflite": "concurrently -k \"powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run_local_tflite_demo.ps1 -Port 8001\" \"cross-env VITE_FARM_STATE_API_URL=http://127.0.0.1:8001 VITE_REFERENCE_API_URL=http://127.0.0.1:8001 npm run dev -- --host 127.0.0.1\"",
    "demo:codex-models:install": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/install_crop_model_bundle.ps1",
    "demo:codex-models": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run_local_model_registry_demo.ps1 -Port 8001",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:desktop": "node --test tests/desktop",
    "test:ui": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  }
}
