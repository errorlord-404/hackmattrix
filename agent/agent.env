# Trusted local launcher configuration for the KisanSathi MCP server.
# Use the FastAPI backend started by scripts/start-demo.ps1; do not point this
# at the currently degraded 8012 container until its Mongo connection is fixed.
KISANSATHI_BACKEND_URL=http://127.0.0.1:8001
KISANSATHI_FARMER_ID=demo
KISANSATHI_TIMEOUT_SECONDS=20
KISANSATHI_MAX_RESPONSE_BYTES=12000

# Agent policy is enforced in farmer_system_prompt.md and the KisanSathi skill:
# for machinery, logistics, buyer, exporter or post-harvest support, first
# check current web evidence and then query the KisanSathi reference catalog.
# Both sources must retain provenance and may be unavailable independently.
KISANSATHI_SUPPORT_DISCOVERY_POLICY=web_then_reference_catalog
