{
  "version": 1,
  "scope": "Electron farmStateApi persistent or external-provider mutations",
  "operations": [
    { "manual_api": "loadDemoData", "designation": "human_only", "reason": "Loads local demonstration data and must never be initiated by the farmer agent." },
    { "manual_api": "startTomatoDemo", "designation": "human_only", "reason": "Starts the local Tomato prototype simulator; it creates source-labelled demo readings and never controls hardware." },
    { "manual_api": "tickTomatoDemo", "designation": "human_only", "reason": "Advances local simulated Tomato values for the visible hackathon demo; it never controls hardware." },
    { "manual_api": "irrigateTomatoDemo", "designation": "human_only", "reason": "Changes only future local simulator values to demonstrate an irrigation response; it does not record or execute physical irrigation." },
    { "manual_api": "stopTomatoDemo", "designation": "human_only", "reason": "Stops the local Tomato prototype simulator; it has no physical hardware effect." },
    { "manual_api": "updateProfile", "mcp_tool": "update_profile" },
    { "manual_api": "createField", "mcp_tool": "create_field" },
    { "manual_api": "updateField", "mcp_tool": "update_field" },
    { "manual_api": "createIrrigationEvent", "mcp_tool": "record_irrigation_event" },
    { "manual_api": "createReminder", "mcp_tool": "create_reminder" },
    { "manual_api": "createFieldTask", "mcp_tool": "create_field_task" },
    { "manual_api": "updateFieldTaskStatus", "mcp_tool": "update_field_task_status" },
    { "manual_api": "createLedgerEntry", "mcp_tool": "record_ledger_entry" },
    { "manual_api": "updateLedgerEntryStatus", "mcp_tool": "update_ledger_entry_status" },
    { "manual_api": "updateAlert", "mcp_tool": "update_alert_status" },
    { "manual_api": "stageCropImage", "designation": "human_only", "reason": "Stages a private image selected by the farmer; it does not transmit it to an external crop-health provider." },
    { "manual_api": "createCropHealthConsent", "designation": "human_only", "reason": "Records the farmer's explicit approval or refusal for the named crop-health provider." },
    { "manual_api": "createDiagnosisFromUpload", "mcp_tool": "assess_crop_problem" },
    { "manual_api": "createDiagnosis", "mcp_tool": "diagnose_crop" },
    { "manual_api": "createDiagnosisFeedback", "mcp_tool": "submit_diagnosis_feedback" },
    { "manual_api": "createAdvisorSession", "mcp_tool": "create_advisor_session" },
    { "manual_api": "sendAdvisorMessage", "mcp_tool": "ask_farm_advisor" },
    { "manual_api": "sendVoiceTurn", "mcp_tool": "send_voice_turn" },
    { "manual_api": "transcribeVoice", "mcp_tool": "transcribe_audio" },
    { "manual_api": "synthesizeSpeech", "mcp_tool": "synthesize_speech" },
    { "manual_api": "translateText", "mcp_tool": "translate_text" },
    { "manual_api": "updateSarvamRuntimeConfig", "designation": "human_only", "reason": "Accepts a provider credential. Credentials are entered only through the Electron settings screen and are never exposed to Codex." },
    { "manual_api": "createReport", "mcp_tool": "create_report" }
  ]
}
